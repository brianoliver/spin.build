<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>build.spin</groupId>
        <artifactId>project</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>spin</artifactId>
    <packaging>jar</packaging>

    <name>Spin Command Line Application</name>

    <dependencies>
        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-common</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-engine</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>

        <!-- ServiceLoader-discovered plugin modules -->
        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-checkstyle-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-clean-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-configuration-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-git-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-gpg-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- imported directly by Spin.java (JarPlugin, for alias derivation) -->
        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-jar-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-java-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-junit-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-maven-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-module-system-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-reporting-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-commandline</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-configuration</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-flow</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-foundation</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-option</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-table</artifactId>
        </dependency>
        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-telemetry</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- shared config for every percolate-maven-exec-plugin execution of spin1
                     below (the self-hosting pipeline and the -Pspin-dev loop): same launch
                     target, only phase/arguments/debug differ per execution -->
                <plugin>
                    <groupId>build.percolate</groupId>
                    <artifactId>percolate-maven-exec-plugin</artifactId>
                    <version>${percolate.version}</version>
                    <configuration>
                        <mainClass>build.spin.application.Spin</mainClass>
                        <rootModule>build.spin.application</rootModule>
                        <scope>runtime</scope>
                        <additionalJvmArgs>
                            <additionalJvmArg>--enable-preview</additionalJvmArg>
                        </additionalJvmArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <ignoredUnusedDeclaredDependencies>
                        <!-- ServiceLoader-discovered plugin modules; no direct class imports -->
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-checkstyle-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-clean-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-configuration-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-git-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-gpg-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-java-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-junit-module</ignoredUnusedDeclaredDependency>
                        <!-- ServiceLoader-discovered; Spin.java imports build.spin.module.jar.JarPlugin (from
                             spin-jar-module, a transitive dep of spin-maven-module) for alias derivation, but
                             nothing in spin imports spin-maven-module's own classes directly -->
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-maven-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-module-system-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-reporting-module</ignoredUnusedDeclaredDependency>
                    </ignoredUnusedDeclaredDependencies>
                </configuration>
            </plugin>

            <plugin>
                <groupId>build.percolate</groupId>
                <artifactId>percolate-maven-exec-plugin</artifactId>
                <executions>
                    <!-- Maven builds spin₁; spin₁ builds spin₂ (jlink image) -->
                    <execution>
                        <id>spin1-build-spin2</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <arguments>
                                <argument>clean</argument>
                                <argument>jlink</argument>
                                <argument>--jlink-host-only</argument>
                                <!-- spin1 already recompiled every sibling as part of this Maven reactor
                                     build; no point paying to recompile them again with spin's own javac
                                     here just to build spin2 -->
                                <argument>--reuse-external-build-output</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <!-- spin₂ builds spin₃, then verify spin₂ == spin₃ -->
                    <execution>
                        <id>spin2-build-spin3</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/src/main/scripts/spin2-build-spin3.sh</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/src.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
      Dev-loop launcher: runs the *current* (uninstalled, un-jlinked) spin1 sources directly,
      instead of the self-hosting spin1-build-spin2-build-spin3 pipeline above (which always
      hardcodes "clean jlink -jlink-host-only -reuse-external-build-output" and requires a
      full install to try out). Off by default; invoke explicitly with -Pspin-dev.

      Usage, from the spin.build root:
          ./mvnw -pl spin -am compile -Pspin-dev -Dpercolate.exec.args="-w /path/to/project jdeps"

      -am rebuilds only the spin.build modules actually touched; binding to the compile phase
      (rather than prepare-package) means it runs right after compilation, skipping
      test-compile/test/package entirely. percolate.exec.args takes whatever spin task-line
      you'd normally pass on the command line, verbatim.
    -->
        <profile>
            <id>spin-dev</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>build.percolate</groupId>
                        <artifactId>percolate-maven-exec-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>spin-dev</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <!-- mainClass/rootModule/scope/additionalJvmArgs come from
                                     pluginManagement above; no hardcoded <arguments> - always
                                     supplied via -Dpercolate.exec.args at invocation time -->
                                <configuration>
                                    <!-- Unlike the spin1-build-spin2 execution below (which relies
                                         on the default cwd == this module's basedir to target the
                                         spin project itself), this execution's -w is always
                                         supplied explicitly by the caller, relative to wherever
                                         ./mvnw was invoked - so pin cwd to the reactor root to
                                         match that expectation. -->
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
      Debug switch for BOTH percolate-maven-exec-plugin executions in this file - the
      spin1-build-spin2 pipeline above and spin-dev above. percolate.exec.jvmArgs (see ExecMojo)
      is a Maven property, so setting it here as a profile property satisfies it for whichever
      execution actually runs; neither execution's <configuration> needs to know this profile
      exists. suspend=y blocks spin1 at startup until a debugger attaches on port 5005.

      Usage: add -Pdebug to either invocation, e.g.
          ./mvnw -pl spin -am compile -Pspin-dev,debug -Dpercolate.exec.args="-w /path/to/project jdeps"
          ./mvnw -pl spin -am prepare-package -Pdebug
    -->
        <profile>
            <id>debug</id>
            <properties>
                <percolate.exec.jvmArgs>--enable-preview -agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005</percolate.exec.jvmArgs>
            </properties>
        </profile>
    </profiles>
</project>
