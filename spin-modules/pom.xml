<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>build.spin</groupId>
        <artifactId>project</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>build.spin.module</groupId>
    <artifactId>spin-modules</artifactId>

    <packaging>pom</packaging>

    <name>Spin Modules</name>

    <dependencies>
        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-engine</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>analyze-dependencies</id>
                        <configuration>
                            <ignoredUnusedDeclaredDependencies>
                                <!-- spin-engine is declared in the parent pom for JPMS module-path
                                     resolution; bytecode analyzer marks it unused since modules use
                                     its packages transitively via module-info, not via direct imports.
                                     Note: any new module added under spin-modules/ will inherit this
                                     dependency automatically. -->
                                <ignoredUnusedDeclaredDependency>build.spin:spin-engine</ignoredUnusedDeclaredDependency>
                            </ignoredUnusedDeclaredDependencies>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>spin-clean-module</module>
        <module>spin-checkstyle-module</module>
        <module>spin-configuration-module</module>
        <module>spin-git-module</module>
        <module>spin-gpg-module</module>
        <module>spin-jar-module</module>
        <module>spin-java-module</module>
        <module>spin-engine-tests</module>
        <module>spin-java-module-tests</module>
        <module>spin-junit-module</module>
        <module>spin-maven-module</module>
        <module>spin-module-system-module</module>
        <module>spin-reporting-module</module>
    </modules>
</project>
