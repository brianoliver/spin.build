package build.spin.module.java;

template TextOut ScriptTemplate(String classpath, boolean hasModulePath, String rootModule, String mainClass, String name, String enableNativeAccess) {
#!/bin/sh

SCRIPTPATH=$(dirname `readlink -f "$0"`)

@if (classpath != null && !classpath.isEmpty()) {
LIB=`readlink -f "$SCRIPTPATH/../classpath"`
@}
@if (hasModulePath) {
MP=`readlink -f "$SCRIPTPATH/../modules"`
@}
CDS=`readlink -f "$SCRIPTPATH/.."`/app.jsa

$SCRIPTPATH/java --enable-preview -XX:+AutoCreateSharedArchive -XX:SharedArchiveFile=$CDS -Xlog:cds=error#{enableNativeAccess != null && !enableNativeAccess.isEmpty() ? " --enable-native-access=" + enableNativeAccess : ""}#{hasModulePath ? " --module-path $MP" : ""}#{classpath != null && !classpath.isEmpty() ? " -cp " + classpath : ""} -m #{rootModule}/#{mainClass} $@
@end
